<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job. Install it with ops/install_schedule.sh, which fills in
  __PROJECT__, validates the result with plutil, and registers it. Do not copy
  this file into ~/Library/LaunchAgents by hand.

  The DOCTYPE above is not decoration. launchd rejects a plist without it,
  `launchctl load` reports that rejection silently, and the job then never
  runs while still looking installed.

  It fires nine times through the morning because Whoop does not score a night
  until you wake. 05:00 is for Wednesday run club; the rest catch the recovery
  score whenever it lands. Every run is idempotent, and a session already
  logged as completed is never rewritten.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nickward.tenk</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT__/ops/run_daily.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <key>StandardOutPath</key>
    <string>__PROJECT__/state/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/state/launchd.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
