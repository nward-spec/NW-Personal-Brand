<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job.

  It fires several times through the morning, not once, because Whoop does not
  score a night until you wake. A 05:00 run alone would usually find no
  recovery and fall back to green, which is the safe default but the wrong
  everyday behaviour.

  05:00 exists for Wednesday, so the session is on the watch before run club at
  05:50. The later firings catch the recovery score whenever it lands. Every
  run is idempotent: intervals.icu events upsert on their external id, and a
  session already logged as completed is never rewritten.

  Times are local, so this follows Melbourne through the AEDT change on 4 Oct
  without any offset arithmetic.

    sed "s|/Users/nick/|$HOME/|g" ops/com.nickward.tenk.plist \
      > ~/Library/LaunchAgents/com.nickward.tenk.plist
    launchctl load ~/Library/LaunchAgents/com.nickward.tenk.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nickward.tenk</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nick/NW-Personal-Brand/project/10k-automation/ops/run_daily.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/nick/NW-Personal-Brand/project/10k-automation</string>
    <key>StandardOutPath</key>
    <string>/Users/nick/NW-Personal-Brand/project/10k-automation/state/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/nick/NW-Personal-Brand/project/10k-automation/state/launchd.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
